{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Software Hub",
  "version": "0.7.4",
  "identifier": "com.lostheaven.softwarehub",
  "build": {
    "beforeBuildCommand": "node scripts/stage-fonts.cjs",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Software Hub",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "backgroundColor": "#020203",
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximized": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
